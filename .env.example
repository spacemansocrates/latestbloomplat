# Environment Configuration Example
# Copy to .env and fill in. Comments use '#'. Do NOT switch config/db_connect.php back
# to parse_ini_file(): PHP's INI parser does not treat '#' as a comment and chokes on the
# parentheses below. utils/env_loader.php reads this format correctly.

# Database Configuration
DB_HOST=your_database_host
DB_NAME=your_database_name
DB_PORT=3306
DB_USER=your_database_username
DB_PASSWORD=your_database_password
DB_CHARSET=utf8mb4

# Email (Hostinger SMTP, the mailbox the domain already pays for)
# FROM_EMAIL MUST equal SMTP_USERNAME. Hostinger will not relay mail claiming to be from
# an address the authenticated mailbox does not own, and the send fails outright.
# SMTP_PASSWORD is the MAILBOX password from hPanel > Emails, not the account password.
# Port 587 with SMTP_SECURE=tls also works if 465 is blocked.
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_SECURE=ssl
SMTP_USERNAME=contact@yourdomain.com
SMTP_PASSWORD=your_mailbox_password
FROM_EMAIL=contact@yourdomain.com
FROM_NAME=Your Brand
SITE_URL=https://portal.yourdomain.com
DEBUG_MODE=false

# Recording storage: any S3-compatible bucket. Cloudflare R2 is what this is built for.
# Without ALL FIVE of these set, s3_configured() is false and lesson recordings pile up on
# the server's local disk, which is not the intended behaviour. When configured,
# tutor/api/upload_recording.php uploads the finished recording and deletes the local copy,
# and api/recording_url.php serves it back through a short-lived presigned URL.
# R2 values come from the Cloudflare dashboard, R2 > Manage API tokens.
#   S3_ENDPOINT = https://<account_id>.r2.cloudflarestorage.com   (no bucket in the path)
#   S3_REGION   = auto                                            (R2 ignores the region)
S3_ENDPOINT=https://your_account_id.r2.cloudflarestorage.com
S3_REGION=auto
S3_BUCKET=your_bucket_name
S3_ACCESS_KEY_ID=your_r2_access_key_id
S3_SECRET_ACCESS_KEY=your_r2_secret_access_key

# LiveKit Cloud: the live lesson room. Values are on your LiveKit Cloud project settings
# page. The room will not start without these.
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=your_livekit_api_key
LIVEKIT_API_SECRET=your_livekit_api_secret

# Encrypts credentials stored in the database (the Twilio Auth Token entered on
# Admin > WhatsApp). Create it with: php tools/generate_encryption_key.php --write
# Never change or lose it: every stored secret was encrypted with it.
APP_ENCRYPTION_KEY=

# WhatsApp is normally configured on Admin > WhatsApp. Any of these set here wins over
# the admin screen and shows there read-only. See docs/whatsapp_templates.md.
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_WHATSAPP_FROM=
# WHATSAPP_TEMPLATE_DIGEST_SID=
# WHATSAPP_TEMPLATE_REMINDER_SID=
# WHATSAPP_ENABLED=false
